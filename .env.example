# cp-adapter config — deploy this beside YOUR New API (control plane).
# The CP signing seed is YOURS; it never goes to the fidrouter platform.
CP_SEED_HEX=            # ed25519 seed (hex). Its public half is baked into YOUR enclave image (config/public.json).
NEWAPI_BASE=https://your-newapi.example
ENCLAVE_URL=http://your-enclave:9090
EXPECTED_MEASUREMENT=sha256:...      # your enclave's reproducible-build measurement
VERIFY_URL=https://verify.<ip>.sslip.io
MODELS=claude-opus-5,claude-sonnet-5,claude-haiku-4-5-20251001
PORT=8091
QUOTA_PER_USD=500000
